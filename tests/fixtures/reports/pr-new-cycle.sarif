          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Hard-coded service dependency: user-service uses http://order-service:8080/orders/1. user-service directly references http://order-service:8080/orders/1 in user-service/app.py:26. This creates a hard-coded service dependency that can bypass service discovery or environment-specific configuration. How to fix: Move the endpoint value into environment-specific configuration or secrets. Centralize client creation behind a typed adapter or service discovery abstraction."
          },
          "locations": [
            {
              "physicalLocation": {
