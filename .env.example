# Directories the API may scan through POST /analyze and POST /projects/{id}/scans.
# Separate several with ":" (";" on Windows). Leave empty to use MESA_WORKSPACE_ROOT
# (/workspace in Docker Compose), or the repository root if that is not set either.
MESA_ALLOWED_SCAN_ROOTS=

MESA_AI_MODE=grounded
MESA_OPENAI_API_KEY=
MESA_OPENAI_MODEL=gpt-5.4-mini
MESA_OPENAI_BASE_URL=https://api.openai.com/v1
MESA_OPENAI_TIMEOUT_SECONDS=20
# AI explainer provider: openai (default) or anthropic
MESA_AI_PROVIDER=openai
ANTHROPIC_API_KEY=
MESA_ANTHROPIC_EXPLAINER_MODEL=claude-opus-5-5
MESA_ANTHROPIC_EFFORT=low
