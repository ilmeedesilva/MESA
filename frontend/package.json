{
  "name": "mesa-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/generate-docs-bundle.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-docs-bundle.mjs",
    "build": "tsc && vite build",
    "prelint": "node scripts/generate-docs-bundle.mjs",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/generate-docs-bundle.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
